{
  "name": "Vyom Video Conferencing",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "user": "ubuntu",
  "install": "./scripts/cloud-agent-install.sh",
  "start": "./scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && npm run dev"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev"
    }
  ],
  "ports": [5000, 5173]
}
